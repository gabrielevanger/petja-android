<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="pt">
    <!-- Textos usados em mais de uma tela. -->
    <string name="common_retry">Tentar de novo</string>
    <string name="common_back">Voltar</string>
    <string name="store_status_open">Aberta</string>
    <string name="store_status_closed">Fechada</string>
    <!-- Entre informações curtas na mesma linha: "Centro · 440 m". As aspas preservam os espaços. -->
    <string name="separator_dot">" · "</string>
    <string name="cart_bar_action">Ver carrinho</string>
    <plurals name="cart_bar_items">
        <item quantity="one">%1$d item</item>
        <!-- "many" é a forma do português para números como 1 milhão ("1 milhão de itens"). -->
        <item quantity="many">%1$d de itens</item>
        <item quantity="other">%1$d itens</item>
    </plurals>
    <!-- Data e hora curtas: "18/10 às 11:15". Texto entre aspas simples sai literal. -->
    <string name="date_time_pattern" translatable="false">dd/MM \'às\' HH:mm</string>
    <string name="date_time_locale" translatable="false">pt-BR</string>
</resources>
