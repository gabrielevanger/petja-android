root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# Mesmo estilo do formatador do Android Studio: "Reformat Code" e ktlint concordam.
ktlint_code_style = android_studio
max_line_length = 120
# Vírgula final recomendada pelo guia oficial do Kotlin: incluir um parâmetro altera uma linha só no diff.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Funções @Composable começam com maiúscula por convenção do Compose.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{js,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
