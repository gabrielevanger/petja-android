# LF em todo arquivo de texto, independente do sistema operacional.
# O gradlew e os hooks rodam em Linux no CI e quebram com CRLF.
* text=auto eol=lf

# Scripts do Windows precisam de CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários: nunca converter.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.jks binary
*.keystore binary
